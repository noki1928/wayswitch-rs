# wayswitch-rs: /dev/uinput доступен группе input (как клавиатуры в systemd-дистрибутивах).
#
# В отличие от правила WaySwitch, здесь НЕТ TAG+="uaccess" для клавиатур:
# uaccess открывает их чтение любому процессу пользователя, то есть любая
# программа может работать как кейлоггер. Демон устанавливается setgid-группой
# input и берёт эти права только на время открытия устройств.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
